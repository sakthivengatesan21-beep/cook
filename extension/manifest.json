{
  "manifest_version": 3,
  "name": "COOK — Creator Workflow Automation",
  "version": "1.0.0",
  "description": "Discover inspiration, capture hooks, and send content ideas directly into your COOK Creator Workspace.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "COOK — Creator Workflow"
  }
}
